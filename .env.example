# Example PyRedis environment configuration.
#
# Copy to `.env` and adjust. PyRedis itself reads the process environment and
# does not parse `.env` files; load one explicitly with:
#
#     uv run --env-file .env pyredis
#
# Every variable below is optional -- the defaults shown are what PyRedis uses
# when the variable is unset.

# Interface the server will bind to (P2 onwards).
PYREDIS_HOST=127.0.0.1

# TCP port. 6380 avoids colliding with a real Redis on 6379.
PYREDIS_PORT=6380

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
PYREDIS_LOG_LEVEL=INFO

# Append every mutation to a log and replay it at startup. Off by default, so
# running PyRedis never writes files into the directory it was launched from.
PYREDIS_AOF_ENABLED=false
PYREDIS_AOF_PATH=pyredis.aof

# How hard to work at getting writes onto the disk: always, everysec, or no.
# Every policy flushes to the OS on each write, so killing the process loses
# nothing; this only decides what a power failure can take.
PYREDIS_AOF_FSYNC=everysec

# Bound the keyspace. 0 is unlimited. Sizes are binary: a bare number is bytes,
# and kb/mb/gb mean 1024, 1024^2 and 1024^3 (64kb, 10mb, 1gb). The ambiguous
# 1k/1m/1g forms are rejected rather than guessed at.
PYREDIS_MAXMEMORY=0

# What to do at the ceiling: noeviction refuses the write, allkeys-lru evicts
# the least recently used keys to make room.
PYREDIS_MAXMEMORY_POLICY=noeviction
