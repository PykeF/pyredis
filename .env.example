# Example PyRedis environment configuration.
#
# Copy to `.env` and adjust. PyRedis itself reads the process environment and
# does not parse `.env` files; load one explicitly with:
#
#     uv run --env-file .env pyredis
#
# Every variable below is optional -- the defaults shown are what PyRedis uses
# when the variable is unset.

# Interface the server will bind to (P2 onwards).
PYREDIS_HOST=127.0.0.1

# TCP port. 6380 avoids colliding with a real Redis on 6379.
PYREDIS_PORT=6380

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
PYREDIS_LOG_LEVEL=INFO
